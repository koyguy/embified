PORT=3002
AUTH_DIR=./auth_info
DATA_DIR=./data
LOG_LEVEL=info

# baileys (linked device) or cloud (official Cloud API)
WA_PROVIDER=baileys

# Official WhatsApp Cloud API (Meta)
# Create an app at https://developers.facebook.com/ → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional: verify X-Hub-Signature-256 on webhooks
WHATSAPP_APP_SECRET=
# Optional
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_VERSION=v22.0
# Public origin for Meta webhooks (set automatically if a tunnel is started)
WEBHOOK_PUBLIC_URL=
