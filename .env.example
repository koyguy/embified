PORT=3002
AUTH_DIR=./auth_info
DATA_DIR=./data
LOG_LEVEL=info

# baileys (linked device) or cloud (official Cloud API)
WA_PROVIDER=baileys

# Official WhatsApp Cloud API (Meta)
# Create an app at https://developers.facebook.com/ → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Optional: verify X-Hub-Signature-256 on webhooks
WHATSAPP_APP_SECRET=
# Optional
WHATSAPP_WABA_ID=
WHATSAPP_GRAPH_VERSION=v22.0
# Public origin for Meta webhooks (set automatically if a tunnel is started)
WEBHOOK_PUBLIC_URL=

# Public signup site that /start, /vault, /create-vault, /cloud-setup, /home-setup 301 to
# (and the login page's "New here?" link). Default: https://koyguy.github.io/embified
# PUBLIC_SITE_URL=https://koyguy.github.io/embified

# Product vault meter (Always Free ~200 GiB story)
EMBIFIED_QUOTA_BYTES=214748364800
# Optional: put vault on attached block volume
# DATA_DIR=/data/store
# AUTH_DIR=/data/auth

# Inbox auth wall (leave unset to keep open — not for public IPs)
EMBIFIED_AUTH_PASSWORD=
# Optional cookie signing secret (defaults to the password)
# EMBIFIED_AUTH_SECRET=
# Force the Secure cookie flag (https requests through the tunnel already get it automatically)
# EMBIFIED_AUTH_SECURE=false
# HTTPS address: quick-tunnel URL file, or pin a named-tunnel/domain origin (wins over the file)
# EMBIFIED_TUNNEL_URL_FILE=/var/lib/embified/tunnel-url.txt
# EMBIFIED_PUBLIC_URL=https://vault.example.com
# EMBIFIED_TRUST_PROXY=loopback
